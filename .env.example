# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1h

# Redis (opcional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# External APIs
VIACEP_TIMEOUT=3000
HOLIDAYS_API_TIMEOUT=2000
